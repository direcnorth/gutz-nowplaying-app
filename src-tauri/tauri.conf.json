{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gutz Now Playing",
  "version": "0.1.6",
  "identifier": "de.gutz.nowplaying",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "dmg", "app"],
    "publisher": "Gutzkowclub Dresden e.V.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMUZBNzAwMDhGMEZFQ0QKUldUTi92QUlBS2Nmdmk1QjRwSFZhcVR0ZjVONkdZSW4ydXBONERqU2hVNlBlTFpxOFlNQ1ovdm4K",
      "endpoints": [
        "https://github.com/direcnorth/gutz-nowplaying-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
